{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --no-workspaces",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/embed/:path*",
      "destination": "https://deckr-api.onrender.com/embed/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://deckr-api.onrender.com/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
