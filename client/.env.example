# Base URL for the Deckr API. Leave blank in dev to use the Vite proxy.
VITE_API_URL=
# Only needed if your API runs somewhere other than http://localhost:4000 in dev
VITE_PROXY_TARGET=http://localhost:4000

# "Buy me a coffee" support link shown in the footer
VITE_SUPPORT_URL=https://www.buymeacoffee.com/
