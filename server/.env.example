# Server
PORT=4000
NODE_ENV=development

# Mongo. Leave blank in dev to auto start an in-memory MongoDB (data is wiped
# on restart). Set an Atlas M0 connection string to persist, and always set it
# in production.
MONGODB_URI=

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# GitHub OAuth app (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
# Must match the callback registered on the GitHub OAuth app
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Allowed browser origin(s) for CORS and the post-login redirect target.
# No trailing slash. Comma separated if you need more than one.
CLIENT_URL=http://localhost:5173

# Set to "true" to also allow any *.vercel.app preview deployment through CORS
ALLOW_VERCEL_PREVIEWS=false

# Public site URL used to build absolute links in /sitemap.xml. Defaults to
# CLIENT_URL. Set this if the site is served from a custom domain.
PUBLIC_SITE_URL=

# Optional: link for the "Buy me a coffee" button (client build var, set in client/.env)
# VITE_SUPPORT_URL=https://www.buymeacoffee.com/yourname
